@layout.public()
<div class="mx-auto max-w-6xl">
  <div class="mb-8 rounded-2xl border border-outline bg-surface p-6 shadow-sm sm:p-8">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">Voyager Public</p>
    <h1 class="mt-2 text-3xl font-bold text-on-surface-strong sm:text-4xl">Trouvez et reservez un voyage en quelques
      clics</h1>
    <p class="mt-3 max-w-2xl text-sm text-on-surface">Les trajets a venir sont affiches automatiquement. Utilisez les
      filtres pour affiner votre recherche.</p>
  </div>

  {{-- Search form --}}
  <div class="mb-8 rounded-2xl border border-outline bg-surface p-6 shadow-sm">
    <form method="GET"
      action="{{ tenantSlug ? route('public.trips.index', { tenantSlug }) : route('public.globalTrips.index') }}"
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <label for="from" class="mb-1 block text-sm font-medium text-on-surface-strong">Départ</label>
        <select id="from" name="from"
          class="w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
          <option value="">Sélectionner</option>
          @each(city in cities)
          <option value="{{ city.id }}" @if(filters.from===city.id) selected @end>{{ city.name }}</option>
          @end
        </select>
      </div>

      <div>
        <label for="to" class="mb-1 block text-sm font-medium text-on-surface-strong">Arrivée</label>
        <select id="to" name="to"
          class="w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
          <option value="">Sélectionner</option>
          @each(city in cities)
          <option value="{{ city.id }}" @if(filters.to===city.id) selected @end>{{ city.name }}</option>
          @end
        </select>
      </div>

      <div>
        <label for="date" class="mb-1 block text-sm font-medium text-on-surface-strong">Date</label>
        <input type="date" id="date" name="date" value="{{ filters.date ?? '' }}"
          class="w-full rounded-radius border border-outline bg-surface px-3 py-2 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
      </div>

      <div class="flex items-end">
        <button type="submit"
          class="w-full rounded-radius bg-primary px-4 py-2.5 text-sm font-medium text-on-primary transition-colors hover:bg-secondary">
          Rechercher
        </button>
      </div>
    </form>
  </div>

  {{-- Results --}}
  @if(trips.length)
  <div class="space-y-4">
    @if(filters.from && filters.to && filters.date)
    <h2 class="text-lg font-semibold text-on-surface-strong">{{ trips.length }} voyage(s) disponible(s)</h2>
    @else
    <h2 class="text-lg font-semibold text-on-surface-strong">Voyages disponibles</h2>
    @end
    @each(item in trips)
    <div class="rounded-2xl border border-outline bg-surface p-5 shadow-sm">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex-1 space-y-2">
          <p class="text-base font-semibold text-on-surface-strong">
            {{ item.trip.route.departureCity.name }} → {{ item.trip.route.arrivalCity.name }}
          </p>
          <p class="text-sm text-on-surface">
            Départ&nbsp;: {{ item.trip.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
          </p>
          <p class="text-sm text-on-surface">
            Compagnie&nbsp;:
            <a href="{{ route('public.tenants.show', { tenantSlug: item.trip.tenant.slug }) }}"
              class="font-medium text-primary hover:underline">{{ item.trip.tenant.name }}</a>
          </p>
          <div class="flex flex-wrap items-center gap-3 text-sm text-on-surface">
            <span>
              Classe&nbsp;:
              @if(item.trip.travelClass === 'vip')
              <span
                class="inline-flex items-center rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-800">VIP</span>
              @else
              <span
                class="inline-flex items-center rounded-full bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-800">Standard</span>
              @end
            </span>
            <span>Prix&nbsp;: <strong>{{ item.trip.price }} FCFA</strong></span>
            <span>Places disponibles&nbsp;: <strong>{{ item.availableSeats }}</strong></span>
          </div>
        </div>
        <div class="shrink-0">
          <form method="POST" action="{{ route('public.bookings.initiate', { tripId: item.trip.id }) }}">
            {{ csrfField() }}
            <button type="submit"
              class="inline-flex w-full items-center justify-center rounded-radius bg-primary px-5 py-2.5 text-sm font-medium text-on-primary transition-colors hover:bg-secondary sm:w-auto">
              Reserver
            </button>
          </form>
        </div>
      </div>
    </div>
    @end
  </div>
  @else
  <div class="rounded-radius border border-outline bg-surface px-6 py-12 text-center text-on-surface">
    @if(filters.from && filters.to && filters.date)
    Aucun voyage trouvé pour cette recherche.
    @else
    Aucun voyage disponible pour le moment.
    @end
  </div>
  @end
</div>
@end