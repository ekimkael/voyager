@layout.base()
<div class="relative flex min-h-screen items-center justify-center overflow-hidden bg-surface-alt px-4">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-1/3 top-1/4 h-80 w-80 rounded-full bg-red-200/20 blur-[100px]"></div>
    <div class="absolute -right-20 bottom-1/3 h-72 w-72 rounded-full bg-amber-200/25 blur-[100px]"></div>
  </div>

  <div class="relative z-10 animate-fade-rise text-center">
    <p class="text-8xl font-bold tracking-tighter text-on-surface-strong sm:text-9xl">500</p>
    <h1 class="mt-4 text-xl font-semibold text-on-surface-strong sm:text-2xl">Erreur serveur</h1>
    <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-on-surface">
      Une erreur inattendue s'est produite. Veuillez réessayer dans quelques instants.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a href="/"
        class="rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-on-primary transition-all duration-200 hover:-translate-y-0.5 hover:bg-secondary hover:shadow-md">
        Retour à l'accueil
      </a>
    </div>
  </div>
</div>
@end
