@filter.bar({ action: route('trips.history') })
  @filter.field()
    <select name="status" id="status"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50">
      <option value="">Tous les statuts</option>
      <option value="completed" {{ filters.status === 'completed' ? 'selected' : '' }}>Terminé</option>
      <option value="cancelled" {{ filters.status === 'cancelled' ? 'selected' : '' }}>Annulé</option>
    </select>
  @end

  @filter.field()
    <select name="route_id" id="route_id"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50">
      <option value="">Toutes les routes</option>
      @each(r in routes)
        <option value="{{ r.id }}" {{ filters.route_id === r.id ? 'selected' : '' }}>
          {{ r.code }} — {{ r.departureCity.name }} → {{ r.arrivalCity.name }}
        </option>
      @end
    </select>
  @end

  @filter.field()
    <select name="driver_id" id="driver_id"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50">
      <option value="">Tous les chauffeurs</option>
      @each(d in drivers)
        <option value="{{ d.id }}" {{ filters.driver_id === d.id ? 'selected' : '' }}>
          {{ d.fullName }}
        </option>
      @end
    </select>
  @end

  @filter.field()
    <select name="bus_id" id="bus_id"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50">
      <option value="">Tous les bus</option>
      @each(b in buses)
        <option value="{{ b.id }}" {{ filters.bus_id === b.id ? 'selected' : '' }}>
          {{ b.licensePlate }} — {{ b.brand }} {{ b.model }}
        </option>
      @end
    </select>
  @end

  @filter.field()
    <select name="travel_class" id="travel_class"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50">
      <option value="">Toutes les classes</option>
      <option value="standard" {{ filters.travel_class === 'standard' ? 'selected' : '' }}>Standard</option>
      <option value="vip" {{ filters.travel_class === 'vip' ? 'selected' : '' }}>VIP</option>
    </select>
  @end

  @filter.field()
    <input type="date" name="date_from" id="date_from" value="{{ filters.date_from || '' }}" placeholder="Date du"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50" />
  @end

  @filter.field()
    <input type="date" name="date_to" id="date_to" value="{{ filters.date_to || '' }}" placeholder="Date au"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50" />
  @end

  @filter.field()
    <input type="number" name="price_min" id="price_min" min="0" step="1" placeholder="Prix min"
      value="{{ filters.price_min !== undefined ? filters.price_min : '' }}"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50" />
  @end

  @filter.field()
    <input type="number" name="price_max" id="price_max" min="0" step="1" placeholder="Prix max"
      value="{{ filters.price_max !== undefined ? filters.price_max : '' }}"
      class="h-9 w-full min-w-0 rounded-md border border-outline bg-transparent px-3 py-1 text-sm text-on-surface-strong shadow-xs outline-none transition-[color,box-shadow] focus-visible:border-primary focus-visible:ring-[3px] focus-visible:ring-primary/50" />
  @end
@end
