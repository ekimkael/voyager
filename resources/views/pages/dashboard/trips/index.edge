@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Voyages</h1>
      <div class="flex items-center gap-3">
        <a href="{{ route('trips.history') }}"
          class="inline-flex items-center gap-2 rounded-md border border-outline bg-surface px-4 py-2 text-sm font-medium text-on-surface shadow-xs hover:bg-surface-alt hover:text-on-surface-strong">
          @svg('tabler:history', { class: 'size-4' })
          Historique
        </a>
        @can('permission', 'trip:create')
          <a href="{{ route('trips.create') }}"
            class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
            @svg('tabler:plus', { class: 'size-4' })
            Nouveau voyage
          </a>
        @end
      </div>
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Route
        @end
        @table.cell({ head: true })
          Bus
        @end
        @table.cell({ head: true })
          Chauffeur
        @end
        @table.cell({ head: true })
          Départ
        @end
        @table.cell({ head: true })
          Classe
        @end
        @table.cell({ head: true })
          Tarif
        @end
        @table.cell({ head: true })
          Statut
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(item in trips)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ item.route.departureCity.name }} → {{ item.route.arrivalCity.name }}</span>
            @end
            @table.cell()
              {{ item.bus.licensePlate }}
            @end
            @table.cell()
              {{ item.driver.fullName }}
            @end
            @table.cell()
              {{ item.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
            @end
            @table.cell()
              @if(item.travelClass === 'vip')
                @!badge({ variant: 'info', text: 'VIP' })
              @else
                @!badge({ variant: 'neutral', text: 'Standard' })
              @end
            @end
            @table.cell()
              {{ item.price }} FCFA
            @end
            @table.cell()
              @if(item.status === 'scheduled')
                @!badge({ variant: 'info', text: 'Planifié' })
              @else
                @!badge({ variant: 'warning', text: 'En cours' })
              @end
            @end
            <td class="px-4 py-3">
              <div x-data="{ open: false }" class="relative">
                <button @click="open = !open" type="button"
                  class="inline-flex size-6 shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap cursor-pointer transition-all outline-none hover:bg-surface-alt hover:text-on-surface-strong [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=size-])]:size-4"
                  aria-haspopup="true" :aria-expanded="open">
                  @svg('tabler:dots', { class: 'size-4' })
                </button>
                <div x-show="open" x-transition @click.outside="open = false" @keydown.escape.window="open = false" x-cloak
                  class="absolute right-0 z-50 mt-1 min-w-[160px] rounded-lg border border-outline bg-surface p-1 shadow-md" role="menu">

                  @can('permission', 'trip:update')
                    @if(item.status === 'scheduled')
                      <form action="{{ route('trips.transition', { id: item.id }) }}" method="POST" class="w-full">
                        {{ csrfField() }}
                        <input type="hidden" name="_method" value="PUT" />
                        <input type="hidden" name="status" value="in_progress" />
                        <button type="submit" @click="open = false" onclick="return confirm('Démarrer ce voyage ?')"
                          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-on-surface-strong hover:bg-surface-alt transition-colors" role="menuitem">
                          @svg('tabler:player-play', { class: 'size-4' })
                          Démarrer
                        </button>
                      </form>
                    @end

                    @if(item.status === 'in_progress')
                      <form action="{{ route('trips.transition', { id: item.id }) }}" method="POST" class="w-full">
                        {{ csrfField() }}
                        <input type="hidden" name="_method" value="PUT" />
                        <input type="hidden" name="status" value="completed" />
                        <button type="submit" @click="open = false" onclick="return confirm('Marquer ce voyage comme terminé ?')"
                          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-on-surface-strong hover:bg-surface-alt transition-colors" role="menuitem">
                          @svg('tabler:circle-check', { class: 'size-4' })
                          Compléter
                        </button>
                      </form>
                    @end

                    @if(item.status === 'scheduled' || item.status === 'in_progress')
                      <a href="{{ route('trips.edit', { id: item.id }) }}" @click="open = false"
                        class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-on-surface-strong hover:bg-surface-alt transition-colors" role="menuitem">
                        @svg('tabler:pencil', { class: 'size-4' })
                        Modifier
                      </a>
                    @end
                  @end

                  @if(item.status === 'scheduled' || item.status === 'in_progress')
                    <div class="my-1 border-t border-outline" role="separator"></div>
                  @end

                  @can('permission', 'trip:update')
                    @if(item.status === 'scheduled' || item.status === 'in_progress')
                      <form action="{{ route('trips.transition', { id: item.id }) }}" method="POST" class="w-full">
                        {{ csrfField() }}
                        <input type="hidden" name="_method" value="PUT" />
                        <input type="hidden" name="status" value="cancelled" />
                        <button type="submit" @click="open = false" onclick="return confirm('Annuler ce voyage ?')"
                          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-danger hover:bg-surface-alt transition-colors" role="menuitem">
                          @svg('tabler:x', { class: 'size-4' })
                          Annuler
                        </button>
                      </form>
                    @end
                  @end

                  @can('permission', 'trip:delete')
                    @if(item.status === 'scheduled')
                      <form action="{{ route('trips.destroy', { id: item.id }) }}" method="POST" class="w-full">
                        {{ csrfField() }}
                        <input type="hidden" name="_method" value="DELETE" />
                        <button type="submit" @click="open = false" onclick="return confirm('Supprimer ce voyage ?')"
                          class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-danger hover:bg-surface-alt transition-colors" role="menuitem">
                          @svg('tabler:trash', { class: 'size-4' })
                          Supprimer
                        </button>
                      </form>
                    @end
                  @end

                </div>
              </div>
            </td>
          @end
        @end

        @if(!trips.length)
          @!table.empty({ colspan: 8, message: 'Aucun voyage actif' })
        @end
      </tbody>
    @end
  </div>
@end
