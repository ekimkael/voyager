@layout.dashboard()
<div class="mx-auto max-w-7xl">
  <div class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-on-surface-strong">Réservations</h1>
    @can('permission', 'booking:create')
    <a href="{{ route('dashboard.bookings.create') }}"
      class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
      @svg('tabler:plus', { class: 'size-4' })
      Nouvelle réservation
    </a>
    @end
  </div>

  @include('pages/dashboard/bookings/_filters')

  {{-- Table --}}
  @table.root()
    @table.header()
      @table.cell({ head: true })
        Date
      @end
      @table.cell({ head: true })
        Voyage
      @end
      @table.cell({ head: true })
        Client
      @end
      @table.cell({ head: true })
        Passagers
      @end
      @table.cell({ head: true })
        Montant
      @end
      @table.cell({ head: true })
        Statut
      @end
      @table.cell({ head: true })
      @end
    @end

    <tbody>
      @each(item in bookings)
        @table.row()
          @table.cell()
            {{ item.createdAt.toFormat('dd/MM/yyyy HH:mm') }}
          @end
          @table.cell()
            <span class="font-medium">{{ item.trip.route.departureCity.name }} → {{ item.trip.route.arrivalCity.name }}</span>
            <span class="block text-xs text-on-surface">
              {{ item.trip.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
            </span>
          @end
          @table.cell()
            @if(item.customer)
              {{ item.customer.firstName }} {{ item.customer.lastName }}
              <span class="block text-xs text-on-surface">{{ item.customer.phone }}</span>
            @else
              <span class="text-on-surface/50">—</span>
            @end
          @end
          @table.cell()
            {{ item.passengers.length }}
          @end
          @table.cell()
            {{ Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'XAF' }).format(item.totalAmount) }}
          @end
          @table.cell()
            @if(item.status === 'pending')
              @!badge({ variant: 'warning', text: 'En attente' })
            @elseif(item.status === 'confirmed')
              @!badge({ variant: 'success', text: 'Confirmée' })
            @else
              @!badge({ variant: 'danger', text: 'Annulée' })
            @end
          @end
          <td class="px-4 py-3">
            <div x-data="{
              open: false,
              pos: {},
              toggle() {
                if (!this.open) {
                  const rect = this.$refs.btn.getBoundingClientRect()
                  const spaceBelow = window.innerHeight - rect.bottom
                  this.pos = spaceBelow < 200
                    ? { bottom: (window.innerHeight - rect.top + 4) + 'px', right: (window.innerWidth - rect.right) + 'px' }
                    : { top: (rect.bottom + 4) + 'px', right: (window.innerWidth - rect.right) + 'px' }
                }
                this.open = !this.open
              }
            }" class="relative">
              <button x-ref="btn" @click="toggle()" type="button"
                class="inline-flex size-6 shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap cursor-pointer transition-all outline-none hover:bg-surface-alt hover:text-on-surface-strong [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=size-])]:size-4"
                aria-haspopup="true" :aria-expanded="open">
                @svg('tabler:dots', { class: 'size-4' })
              </button>
              <div x-show="open" x-transition @click.outside="open = false" @keydown.escape.window="open = false" @scroll.window="open = false" x-cloak
                :style="pos"
                class="fixed z-50 min-w-[160px] rounded-lg border border-outline bg-surface p-1 shadow-md" role="menu">

                <a href="{{ route('dashboard.bookings.show', { id: item.id }) }}" @click="open = false"
                  class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-on-surface-strong hover:bg-surface-alt transition-colors" role="menuitem">
                  @svg('tabler:eye', { class: 'size-4' })
                  Voir
                </a>

                @can('permission', 'booking:update')
                  @if(item.status === 'confirmed')
                    <a href="{{ route('dashboard.bookings.edit', { id: item.id }) }}" @click="open = false"
                      class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-on-surface-strong hover:bg-surface-alt transition-colors" role="menuitem">
                      @svg('tabler:pencil', { class: 'size-4' })
                      Modifier
                    </a>
                  @end
                @end

                @can('permission', 'booking:update')
                  @if(item.status !== 'cancelled')
                    <div class="my-1 border-t border-outline" role="separator"></div>
                    <form action="{{ route('dashboard.bookings.destroy', { id: item.id }) }}" method="POST" class="w-full">
                      {{ csrfField() }}
                      <input type="hidden" name="_method" value="DELETE" />
                      <button type="submit" @click="open = false" onclick="return confirm('Annuler cette réservation ?')"
                        class="flex w-full items-center gap-2 rounded-md px-3 py-1.5 text-sm cursor-pointer text-danger hover:bg-surface-alt transition-colors" role="menuitem">
                        @svg('tabler:ban', { class: 'size-4' })
                        Annuler
                      </button>
                    </form>
                  @end
                @end

              </div>
            </div>
          </td>
        @end
      @end

      @if(!bookings.length)
        @!table.empty({ colspan: 7, message: 'Aucune réservation trouvée' })
      @end
    </tbody>
  @end

  @!pagination({ paginator: bookings })
</div>
@end
