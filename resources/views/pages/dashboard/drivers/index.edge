@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Conducteurs</h1>
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Nom complet
        @end
        @table.cell({ head: true })
          Email
        @end
        @table.cell({ head: true })
          Statut
        @end
      @end

      <tbody>
        @each(driver in drivers)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ driver.fullName }}</span>
            @end
            @table.cell()
              {{ driver.email }}
            @end
            @table.cell()
              @if(driver.status === 'active')
                @!badge({ variant: 'success', text: 'Actif' })
              @elseif(driver.status === 'inactive')
                @!badge({ variant: 'neutral', text: 'Inactif' })
              @else
                @!badge({ variant: 'danger', text: 'Suspendu' })
              @end
            @end
          @end
        @end

        @if(!drivers.length)
          @!table.empty({ colspan: 3, message: 'Aucun conducteur enregistré.' })
        @end
      </tbody>
    @end
  </div>
@end
