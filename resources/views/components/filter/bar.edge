@let(action = $props.get('action') || '')
@let(hasActiveFilters = Object.values(request.qs()).some(v => v))

<form method="GET" action="{{ action }}" class="mb-6 flex flex-wrap items-center gap-2">
  {{{ await $slots.main() }}}
  <button type="submit"
    class="inline-flex size-9 shrink-0 items-center justify-center rounded-md bg-primary text-on-primary shadow-xs hover:bg-primary/90 transition-colors cursor-pointer"
    title="Rechercher">
    @svg('tabler:search', { class: 'size-4' })
  </button>
  @if(hasActiveFilters)
    <a href="{{ action || request.url() }}"
      class="inline-flex size-9 shrink-0 items-center justify-center rounded-md border border-outline text-on-surface shadow-xs hover:bg-surface-alt hover:text-on-surface-strong transition-colors"
      title="Réinitialiser">
      @svg('tabler:x', { class: 'size-4' })
    </a>
  @end
</form>
