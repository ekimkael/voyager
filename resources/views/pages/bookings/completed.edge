@layout.public()
<div class="mx-auto max-w-2xl">

  {{-- Success banner --}}
  <div class="mb-6 animate-fade-rise rounded-2xl border border-emerald-200 bg-emerald-50/80 p-6 backdrop-blur-sm">
    <div class="flex items-start gap-4">
      <div class="relative shrink-0 text-emerald-500 pulse-ring">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <path d="m9 12 2 2 4-4" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-emerald-800">Réservation confirmée !</h1>
        <p class="mt-1 text-sm leading-relaxed text-emerald-700">
          Votre réservation a été enregistrée avec succès. Téléchargez vos tickets ci-dessous.
        </p>
      </div>
    </div>
  </div>

  {{-- Booking reference --}}
  <div class="mb-4 animate-fade-rise delay-100 rounded-2xl border border-outline/60 bg-surface/90 p-6 shadow-sm backdrop-blur-sm">
    <h2 class="mb-4 text-base font-semibold text-on-surface-strong">Informations de réservation</h2>
    <div class="grid grid-cols-1 gap-4 text-sm sm:grid-cols-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Route</p>
        <p class="mt-1 font-medium text-on-surface-strong">
          {{ booking.trip.route.departureCity.name }} → {{ booking.trip.route.arrivalCity.name }}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Départ</p>
        <p class="mt-1 font-medium text-on-surface-strong">
          {{ booking.trip.departureTime.toFormat('dd MMM yyyy à HH:mm', { locale: 'fr' }) }}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Client</p>
        <p class="mt-1 font-medium text-on-surface-strong">
          {{ booking.customer.firstName }} {{ booking.customer.lastName }}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Téléphone</p>
        <p class="mt-1 font-medium text-on-surface-strong">{{ booking.customer.phone }}</p>
      </div>
    </div>
  </div>

  {{-- Passengers & tickets --}}
  <div class="animate-fade-rise delay-200 rounded-2xl border border-outline/60 bg-surface/90 p-6 shadow-sm backdrop-blur-sm">
    <h2 class="mb-4 text-base font-semibold text-on-surface-strong">
      Tickets passagers
    </h2>
    <div class="space-y-3">
      @each(passenger in booking.passengers)
      <div class="flex items-center justify-between rounded-xl border border-outline/60 bg-surface-alt/50 p-4 transition-colors hover:bg-surface-alt">
        <div>
          <p class="text-sm font-medium text-on-surface-strong">
            {{ passenger.firstName }} {{ passenger.lastName }}
          </p>
          <p class="mt-0.5 text-xs text-on-surface">
            Siège : <strong>{{ passenger.seatNumber }}</strong>
            &middot;
            Code : <strong class="font-mono">{{ passenger.code }}</strong>
          </p>
        </div>
        <a href="{{ route('public.tickets.download', { bookingId: booking.id, passengerId: passenger.id }) }}"
          class="inline-flex items-center gap-1.5 rounded-full border border-outline px-4 py-1.5 text-xs font-medium text-on-surface transition-all duration-200 hover:-translate-y-0.5 hover:border-on-surface-strong hover:text-on-surface-strong">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          Télécharger
        </a>
      </div>
      @end
    </div>
  </div>

  {{-- Actions --}}
  <div class="mt-6 animate-fade-rise delay-300 text-center">
    <a href="{{ route('public.globalTrips.index') }}"
      class="inline-flex items-center gap-2 rounded-full border border-outline px-5 py-2.5 text-sm font-medium text-on-surface transition-all duration-200 hover:-translate-y-0.5 hover:border-on-surface-strong hover:text-on-surface-strong">
      Nouvelle réservation
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </a>
  </div>

</div>
@end
