@layout.public()
<div class="mx-auto max-w-2xl">

  {{-- Stepper --}}
  <div class="mb-8 animate-fade-rise">
    <div class="flex items-center gap-0">
      {{-- Step 1 --}}
      <div class="flex items-center gap-2">
        <span class="flex size-8 items-center justify-center rounded-full bg-primary text-xs font-bold text-on-primary">1</span>
        <span class="text-sm font-medium text-on-surface-strong">Passagers</span>
      </div>
      <div class="mx-3 h-px flex-1 bg-outline"></div>
      {{-- Step 2 --}}
      <div class="flex items-center gap-2">
        <span class="flex size-8 items-center justify-center rounded-full border-2 border-outline text-xs font-bold text-on-surface">2</span>
        <span class="hidden text-sm text-on-surface sm:inline">Coordonnées</span>
      </div>
      <div class="mx-3 h-px flex-1 bg-outline"></div>
      {{-- Step 3 --}}
      <div class="flex items-center gap-2">
        <span class="flex size-8 items-center justify-center rounded-full border-2 border-outline text-xs font-bold text-on-surface">3</span>
        <span class="hidden text-sm text-on-surface sm:inline">Récap</span>
      </div>
      <div class="mx-3 h-px flex-1 bg-outline"></div>
      {{-- Step 4 --}}
      <div class="flex items-center gap-2">
        <span class="flex size-8 items-center justify-center rounded-full border-2 border-outline text-xs font-bold text-on-surface">4</span>
        <span class="hidden text-sm text-on-surface sm:inline">Paiement</span>
      </div>
    </div>
  </div>

  {{-- Trip summary --}}
  <div class="mb-6 animate-fade-rise delay-100 rounded-2xl border border-outline/60 bg-surface/90 p-5 backdrop-blur-sm">
    <div class="flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-on-surface" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6v6" /><path d="M15 6v6" /><path d="M2 12h19.6" /><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3" /><circle cx="7" cy="18" r="2" /><path d="M9 18h5" /><circle cx="16" cy="18" r="2" />
      </svg>
      <p class="text-sm font-semibold text-on-surface-strong">
        {{ trip.route.departureCity.name }} → {{ trip.route.arrivalCity.name }}
      </p>
    </div>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm text-on-surface">
      <span>{{ trip.departureTime.toFormat('dd MMM yyyy à HH:mm', { locale: 'fr' }) }}</span>
      <span>{{ Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'XAF' }).format(trip.price) }} / passager</span>
    </div>
    <p class="mt-2 text-sm font-medium" :class="availableSeats <= 0 ? 'text-red-600' : 'text-emerald-600'"
      x-text="availableSeats <= 0 ? 'Plus de places disponibles' : availableSeats + ' place(s) restante(s)'"
      x-data="{ availableSeats: {{ availableSeats }} }">
      {{ availableSeats }} place(s) restante(s)
    </p>
  </div>

  {{-- Passenger form --}}
  <div class="animate-fade-rise delay-200 rounded-2xl border border-outline/60 bg-surface/90 p-6 shadow-sm backdrop-blur-sm">
    <h1 class="mb-5 text-xl font-semibold text-on-surface-strong">Passagers</h1>

    <form method="POST" action="{{ route('public.bookings.storePassengers', { id: booking.id }) }}" x-data="{
          passengers: [{ firstName: '', lastName: '', phone: '' }],
          availableSeats: {{ availableSeats }},
          subscription: null,
          get seatsExhausted() {
            return this.availableSeats <= 0
          },
          get canAddPassenger() {
            return this.passengers.length < this.availableSeats
          },
          addPassenger() {
            if (this.canAddPassenger) {
              this.passengers.push({ firstName: '', lastName: '', phone: '' })
            }
          },
          removePassenger(index) {
            if (this.passengers.length > 1) this.passengers.splice(index, 1)
          },
          async init() {
            const transmit = window.__transmit
            if (transmit) {
              this.subscription = transmit.subscription('trips/{{ booking.tripId }}/seats')
              await this.subscription.create()
              this.subscription.onMessage((data) => {
                this.availableSeats = data.availableSeats
              })
            }
          },
          destroy() {
            if (this.subscription) {
              this.subscription.delete()
            }
          }
        }">
      {{ csrfField() }}

      {{-- Validation errors --}}
      @if(flashMessages.has('errors'))
      <div class="mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        Une erreur s'est produite. Veuillez vérifier les champs ci-dessous.
      </div>
      @end

      <div class="space-y-4" x-ref="passengerList">
        <template x-for="(passenger, index) in passengers" :key="index">
          <div class="rounded-xl border border-outline/60 bg-surface-alt/50 p-4">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-sm font-medium text-on-surface-strong" x-text="'Passager ' + (index + 1)"></p>
              <button type="button" @click="removePassenger(index)" x-show="passengers.length > 1"
                class="flex size-6 items-center justify-center rounded-full text-sm text-red-500 transition-colors hover:bg-red-50 hover:text-red-700"
                title="Supprimer ce passager">
                &times;
              </button>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label class="mb-1 block text-sm font-medium text-on-surface">Prénom <span
                    class="text-red-500">*</span></label>
                <input type="text" :name="'passengers[' + index + '][firstName]'" x-model="passenger.firstName"
                  placeholder="Ex: Jean" required
                  class="h-10 w-full rounded-full border border-outline bg-surface px-4 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              </div>
              <div>
                <label class="mb-1 block text-sm font-medium text-on-surface">Nom <span
                    class="text-red-500">*</span></label>
                <input type="text" :name="'passengers[' + index + '][lastName]'" x-model="passenger.lastName"
                  placeholder="Ex: Dupont" required
                  class="h-10 w-full rounded-full border border-outline bg-surface px-4 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              </div>
              <div class="sm:col-span-2">
                <label class="mb-1 block text-sm font-medium text-on-surface">Téléphone (optionnel)</label>
                <input type="tel" :name="'passengers[' + index + '][phone]'" x-model="passenger.phone"
                  placeholder="Ex: +237 6XX XXX XXX"
                  class="h-10 w-full rounded-full border border-outline bg-surface px-4 text-sm text-on-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              </div>
            </div>
          </div>
        </template>
      </div>

      <div class="mt-4">
        <button type="button" @click="addPassenger()" :disabled="!canAddPassenger"
          :class="canAddPassenger ? 'text-primary hover:text-primary/80' : 'text-neutral-400 cursor-not-allowed'"
          class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm font-medium transition-colors hover:bg-surface-alt">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <path d="M8 12h8" />
            <path d="M12 8v8" />
          </svg>
          Ajouter un passager
        </button>
      </div>

      <div class="mt-6 flex items-center justify-between border-t border-outline/60 pt-5">
        <a href="{{ route('public.globalTrips.index') }}"
          class="inline-flex items-center gap-1.5 text-sm text-on-surface transition-colors hover:text-on-surface-strong">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 19-7-7 7-7" />
            <path d="M19 12H5" />
          </svg>
          Retour
        </a>
        <button type="submit" :disabled="seatsExhausted"
          :class="seatsExhausted ? 'bg-neutral-300 cursor-not-allowed' : 'bg-primary hover:bg-secondary hover:-translate-y-0.5 hover:shadow-md'"
          class="rounded-full px-7 py-2.5 text-sm font-medium text-on-primary transition-all duration-200">
          Suivant
        </button>
      </div>
    </form>
  </div>
</div>
@end
