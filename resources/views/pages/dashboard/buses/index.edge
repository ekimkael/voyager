@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Véhicules</h1>
      @can('permission', 'vehicle:create')
        <a href="{{ route('buses.create') }}"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
          @svg('tabler:plus', { class: 'size-4' })
          Nouveau véhicule
        </a>
      @end
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Immatriculation
        @end
        @table.cell({ head: true })
          Marque
        @end
        @table.cell({ head: true })
          Modèle
        @end
        @table.cell({ head: true })
          Capacité
        @end
        @table.cell({ head: true })
          Année
        @end
        @table.cell({ head: true })
          Statut
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(item in buses)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ item.licensePlate }}</span>
            @end
            @table.cell()
              {{ item.brand }}
            @end
            @table.cell()
              {{ item.model }}
            @end
            @table.cell()
              {{ Intl.NumberFormat('fr-FR').format(item.capacity) }} places
            @end
            @table.cell()
              {{ item.year }}
            @end
            @table.cell()
              @if(item.status === 'available')
                @!badge({ variant: 'success', text: 'Disponible' })
              @elseif(item.status === 'on_trip')
                @!badge({ variant: 'info', text: 'En voyage' })
              @elseif(item.status === 'maintenance')
                @!badge({ variant: 'warning', text: 'Maintenance' })
              @else
                @!badge({ variant: 'danger', text: 'Hors service' })
              @end
            @end
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                @can('permission', 'vehicle:update')
                  <a href="{{ route('buses.edit', { id: item.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors">
                    @svg('tabler:edit', { class: 'size-4' })
                  </a>
                @end
                @can('permission', 'vehicle:delete')
                  @form({ route: 'buses.destroy', routeParams: { id: item.id }, method: 'DELETE' })
                    <button type="submit"
                      class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                      onclick="return confirm('Désactiver ce véhicule ?')">
                      @svg('tabler:trash', { class: 'size-4' })
                    </button>
                  @end
                @end
              </div>
            </td>
          @end
        @end

        @if(!buses.length)
          @!table.empty({ colspan: 7, message: 'Aucun véhicule enregistré.' })
        @end
      </tbody>
    @end
  </div>
@end
