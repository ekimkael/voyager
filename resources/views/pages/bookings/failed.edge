@layout.public()
<div class="mx-auto max-w-lg">

  {{-- Error banner --}}
  <div class="mb-6 animate-fade-rise rounded-2xl border border-red-200 bg-red-50/80 p-6 backdrop-blur-sm">
    <div class="flex items-start gap-4">
      <div class="shrink-0 text-red-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10" />
          <line x1="12" y1="8" x2="12" y2="12" />
          <line x1="12" y1="16" x2="12.01" y2="16" />
        </svg>
      </div>
      <div>
        <h1 class="text-xl font-semibold text-red-800">Échec de la réservation</h1>
        <p class="mt-1 text-sm leading-relaxed text-red-700">
          Une erreur s'est produite lors du traitement de votre réservation.
          Veuillez réessayer ou contacter le support.
        </p>
      </div>
    </div>
  </div>

  {{-- Actions --}}
  <div class="animate-fade-rise delay-100 rounded-2xl border border-outline/60 bg-surface/90 p-6 shadow-sm backdrop-blur-sm">
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      @if(booking)
      <a href="{{ route('public.bookings.payment', { id: booking.id }) }}"
        class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2.5 text-sm font-medium text-on-primary transition-all duration-200 hover:-translate-y-0.5 hover:bg-secondary hover:shadow-md">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
          <path d="M3 3v5h5" />
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16" />
          <path d="M16 16h5v5" />
        </svg>
        Réessayer
      </a>
      @end
      <a href="{{ route('public.globalTrips.index') }}"
        class="inline-flex items-center gap-2 rounded-full border border-outline px-5 py-2.5 text-sm font-medium text-on-surface transition-all duration-200 hover:-translate-y-0.5 hover:border-on-surface-strong hover:text-on-surface-strong">
        Nouvelle réservation
      </a>
    </div>
  </div>

</div>
