@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Réservations</h1>
      @can('permission', 'booking:create')
        <a href="{{ route('dashboard.bookings.create') }}"
          class="inline-flex items-center gap-2 rounded-radius bg-primary px-4 py-2.5 text-sm font-medium text-on-primary hover:bg-secondary transition-colors">
          @svg('tabler:plus', { class: 'size-4' })
          <span>Nouvelle réservation</span>
        </a>
      @end
    </div>

    {{-- Filter bar --}}
    <div class="mb-6 rounded-radius border border-outline bg-surface p-4">
      @form({ route: 'dashboard.bookings.index', method: 'GET' })
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {{-- Date --}}
          <div>
            <label for="date" class="mb-1 block text-sm font-medium text-on-surface">Date</label>
            <input type="date" name="date" id="date" value="{{ filters.date || '' }}"
              class="h-10 w-full rounded-radius border border-neutral-300 bg-surface px-4 text-sm text-on-surface-strong outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          </div>

          {{-- Status --}}
          <div>
            <label for="status" class="mb-1 block text-sm font-medium text-on-surface">Statut</label>
            <select name="status" id="status"
              class="h-10 w-full rounded-radius border border-neutral-300 bg-surface px-4 text-sm text-on-surface-strong outline-none focus:border-primary focus:ring-1 focus:ring-primary">
              <option value="">Tous</option>
              <option value="pending" {{ filters.status === 'pending' ? 'selected' : '' }}>En attente</option>
              <option value="confirmed" {{ filters.status === 'confirmed' ? 'selected' : '' }}>Confirmée</option>
              <option value="cancelled" {{ filters.status === 'cancelled' ? 'selected' : '' }}>Annulée</option>
            </select>
          </div>

          {{-- Code passager --}}
          <div>
            <label for="code" class="mb-1 block text-sm font-medium text-on-surface">Code passager</label>
            <input type="text" name="code" id="code" value="{{ filters.code || '' }}"
              placeholder="Ex: ABC-1234"
              class="h-10 w-full rounded-radius border border-neutral-300 bg-surface px-4 text-sm text-on-surface-strong outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          </div>

          {{-- Search button --}}
          <div class="flex items-end">
            <button type="submit"
              class="inline-flex items-center gap-2 rounded-radius bg-primary px-4 py-2.5 text-sm font-medium text-on-primary hover:bg-secondary transition-colors">
              @svg('tabler:search', { class: 'size-4' })
              <span>Rechercher</span>
            </button>
            @if(filters.date || filters.status || filters.code)
              <a href="{{ route('dashboard.bookings.index') }}"
                class="ml-3 text-sm text-on-surface hover:text-on-surface-strong transition-colors">
                Réinitialiser
              </a>
            @end
          </div>
        </div>
      @end
    </div>

    {{-- Table --}}
    <div class="overflow-hidden rounded-radius border border-outline bg-surface">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-outline bg-surface-alt text-xs uppercase tracking-wider text-on-surface">
          <tr>
            <th class="px-6 py-3">Date</th>
            <th class="px-6 py-3">Voyage</th>
            <th class="px-6 py-3">Client</th>
            <th class="px-6 py-3">Passagers</th>
            <th class="px-6 py-3">Montant</th>
            <th class="px-6 py-3">Statut</th>
            <th class="px-6 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-outline">
          @each(item in bookings)
            <tr class="hover:bg-surface-alt/50">
              <td class="px-6 py-4 text-on-surface">
                {{ item.createdAt.toFormat('dd/MM/yyyy HH:mm') }}
              </td>
              <td class="px-6 py-4 font-medium text-on-surface-strong">
                {{ item.trip.route.departureCity.name }} → {{ item.trip.route.arrivalCity.name }}
                <span class="block text-xs font-normal text-on-surface">
                  {{ item.trip.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
                </span>
              </td>
              <td class="px-6 py-4 text-on-surface">
                {{ item.customer.firstName }} {{ item.customer.lastName }}
                <span class="block text-xs text-on-surface">{{ item.customer.phone }}</span>
              </td>
              <td class="px-6 py-4 text-on-surface">{{ item.passengers.length }}</td>
              <td class="px-6 py-4 text-on-surface">{{ item.totalAmount }} FCFA</td>
              <td class="px-6 py-4">
                @if(item.status === 'pending')
                  <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">En attente</span>
                @elseif(item.status === 'confirmed')
                  <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Confirmée</span>
                @else
                  <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Annulée</span>
                @end
              </td>
              <td class="px-6 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="{{ route('dashboard.bookings.show', { id: item.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors"
                    title="Voir">
                    @svg('tabler:eye', { class: 'size-4' })
                  </a>
                  @can('permission', 'booking:update')
                    @if(item.status === 'confirmed')
                      <a href="{{ route('dashboard.bookings.edit', { id: item.id }) }}"
                        class="text-on-surface hover:text-primary transition-colors"
                        title="Modifier">
                        @svg('tabler:edit', { class: 'size-4' })
                      </a>
                    @end
                  @end
                  @can('permission', 'booking:update')
                    @if(item.status !== 'cancelled')
                      @form({ route: 'dashboard.bookings.destroy', routeParams: { id: item.id }, method: 'DELETE' })
                        <button type="submit"
                          class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                          title="Annuler"
                          onclick="return confirm('Annuler cette réservation ?')">
                          @svg('tabler:ban', { class: 'size-4' })
                        </button>
                      @end
                    @end
                  @end
                </div>
              </td>
            </tr>
          @end
        </tbody>
      </table>

      @if(!bookings.length)
        <div class="px-6 py-12 text-center text-on-surface">
          Aucune réservation trouvée.
        </div>
      @end

      @!pagination({ paginator: bookings })
    </div>
  </div>
@end
