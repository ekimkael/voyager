@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Employés</h1>
      @can('permission', 'user:create')
        <a href="{{ route('employees.create') }}"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
          @svg('tabler:plus', { class: 'size-4' })
          Nouvel employé
        </a>
      @end
    </div>

    @include('pages/dashboard/employees/_filters')

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Nom
        @end
        @table.cell({ head: true })
          Email
        @end
        @table.cell({ head: true })
          Téléphone
        @end
        @table.cell({ head: true })
          Franchise
        @end
        @table.cell({ head: true })
          Rôle
        @end
        @table.cell({ head: true })
          Statut
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(item in employees)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ item.fullName }}</span>
            @end
            @table.cell()
              {{ item.email }}
            @end
            @table.cell()
              {{ item.phone || '—' }}
            @end
            @table.cell()
              {{ item.franchise?.name || '—' }}
            @end
            @table.cell()
              {{ item.roleAssignments?.[0]?.role?.name || '—' }}
            @end
            @table.cell()
              @if(item.status === 'active')
                @!badge({ variant: 'success', text: 'Actif' })
              @elseif(item.status === 'suspended')
                @!badge({ variant: 'danger', text: 'Suspendu' })
              @else
                @!badge({ variant: 'neutral', text: 'Inactif' })
              @end
            @end
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                @can('permission', 'role:assign')
                  <a href="{{ route('employees.roles', { id: item.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors" title="Gérer les rôles">
                    @svg('tabler:shield', { class: 'size-4' })
                  </a>
                @end
                @can('permission', 'user:update')
                  <a href="{{ route('employees.edit', { id: item.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors">
                    @svg('tabler:edit', { class: 'size-4' })
                  </a>
                @end
                @can('permission', 'user:delete')
                  @form({ route: 'employees.destroy', routeParams: { id: item.id }, method: 'DELETE' })
                    <button type="submit"
                      class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                      onclick="return confirm('Désactiver cet employé ?')">
                      @svg('tabler:trash', { class: 'size-4' })
                    </button>
                  @end
                @end
              </div>
            </td>
          @end
        @end

        @if(!employees.length)
          @!table.empty({ colspan: 7, message: 'Aucun employé trouvé.' })
        @end
      </tbody>
    @end

    @!pagination({ paginator: employees })
  </div>
@end
