@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Routes</h1>
      @can('permission', 'route:create')
        <a href="{{ route('routes.create') }}"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
          @svg('tabler:plus', { class: 'size-4' })
          Nouvelle route
        </a>
      @end
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Code
        @end
        @table.cell({ head: true })
          Départ
        @end
        @table.cell({ head: true })
          Arrivée
        @end
        @table.cell({ head: true })
          Distance
        @end
        @table.cell({ head: true })
          Durée
        @end
        @table.cell({ head: true })
          Statut
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(item in routes)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ item.code }}</span>
            @end
            @table.cell()
              {{ item.departureCity.name }}
            @end
            @table.cell()
              {{ item.arrivalCity.name }}
            @end
            @table.cell()
              {{ Intl.NumberFormat('fr-FR').format(item.distanceKm) }} km
            @end
            @table.cell()
              {{ item.formattedDuration }}
            @end
            @table.cell()
              @if(item.status === 'active')
                @!badge({ variant: 'success', text: 'Active' })
              @else
                @!badge({ variant: 'neutral', text: 'Inactive' })
              @end
            @end
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                @can('permission', 'route:update')
                  <a href="{{ route('routes.edit', { id: item.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors">
                    @svg('tabler:edit', { class: 'size-4' })
                  </a>
                @end
                @can('permission', 'route:delete')
                  @form({ route: 'routes.destroy', routeParams: { id: item.id }, method: 'DELETE' })
                    <button type="submit"
                      class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                      onclick="return confirm('Supprimer cette route ?')">
                      @svg('tabler:trash', { class: 'size-4' })
                    </button>
                  @end
                @end
              </div>
            </td>
          @end
        @end

        @if(!routes.length)
          @!table.empty({ colspan: 7, message: 'Aucune route enregistrée.' })
        @end
      </tbody>
    @end
  </div>
@end
