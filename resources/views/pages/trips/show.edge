@layout.public()
<div class="mx-auto max-w-2xl">
  <div class="mb-5 animate-fade-rise">
    <a href="{{ companySlug ? route('public.trips.index', { companySlug }) : route('public.globalTrips.index') }}"
      class="inline-flex items-center gap-1.5 text-sm text-on-surface transition-colors hover:text-on-surface-strong">
      <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7" />
        <path d="M19 12H5" />
      </svg>
      Retour à la recherche
    </a>
  </div>

  <div class="animate-fade-rise delay-100 rounded-2xl border border-outline/60 bg-surface/90 p-6 shadow-sm backdrop-blur-sm sm:p-8">
    {{-- Route header --}}
    <div class="mb-6 flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-on-surface-strong">
        {{ trip.route.departureCity.name }}
      </h1>
      <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0 text-on-surface" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
      <h1 class="text-2xl font-semibold text-on-surface-strong">
        {{ trip.route.arrivalCity.name }}
      </h1>
    </div>

    <div class="space-y-5">
      {{-- Departure / Arrival --}}
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div class="rounded-xl border border-outline/60 bg-surface-alt/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Départ</p>
          <p class="mt-1.5 text-sm font-medium text-on-surface-strong">
            {{ trip.departureTime.toFormat('dd MMM yyyy à HH:mm', { locale: 'fr' }) }}
          </p>
          <p class="mt-0.5 text-sm text-on-surface">{{ trip.route.departureCity.name }}</p>
        </div>
        <div class="rounded-xl border border-outline/60 bg-surface-alt/50 p-4">
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Arrivée</p>
          <p class="mt-1.5 text-sm font-medium text-on-surface-strong">
            {{ trip.arrivalTime.toFormat('dd MMM yyyy à HH:mm', { locale: 'fr' }) }}
          </p>
          <p class="mt-0.5 text-sm text-on-surface">{{ trip.route.arrivalCity.name }}</p>
        </div>
      </div>

      <hr class="border-outline/60" />

      {{-- Trip details --}}
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Classe</p>
          <p class="mt-1.5">
            @if(trip.travelClass === 'vip')
            <span
              class="inline-flex items-center rounded-full bg-purple-100 px-2.5 py-0.5 text-xs font-medium text-purple-800">VIP</span>
            @else
            <span
              class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-700">Standard</span>
            @end
          </p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Bus</p>
          <p class="mt-1.5 text-sm font-medium text-on-surface-strong">{{ trip.bus.licensePlate }}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Prix</p>
          <p class="mt-1.5 text-sm font-medium text-on-surface-strong">{{ Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'XAF' }).format(trip.price) }}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wider text-on-surface">Places</p>
          <p class="mt-1.5 text-sm font-medium text-on-surface-strong">{{ Intl.NumberFormat('fr-FR').format(availableSeats) }}</p>
        </div>
      </div>

      <hr class="border-outline/60" />

      {{-- Booking action --}}
      @if(availableSeats > 0)
      <form method="POST" action="{{ route('public.bookings.initiate') }}?trip={{ trip.id }}">
        {{ csrfField() }}
        <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit"
          class="w-full rounded-full bg-primary px-6 py-3 text-sm font-medium text-on-primary transition-all duration-200 hover:-translate-y-0.5 hover:bg-secondary hover:shadow-md sm:w-auto sm:px-8">
          Réserver ce voyage
        </button>
      </form>
      @else
      <div class="rounded-full border border-outline bg-surface-alt px-6 py-3 text-center text-sm text-on-surface">
        Ce voyage est complet.
      </div>
      @end
    </div>
  </div>
</div>
@end
