@layout.auth({
badgeText: 'Inscription gratuite',
dotClass: 'bg-amber-400',
heroTitle: 'Lancez votre billetterie en ligne en quelques minutes.',
heroDescription: "Créez votre espace, configurez vos trajets et commencez à vendre des billets dès aujourd'hui.",
pageTitle: 'Créer un compte',
pageDescription: 'Enregistrez votre compagnie de transport',
})
@form({ route: 'new_account.store', method: 'POST' })
<div class="flex flex-col gap-5">
  <div>
    @field.root({ name: 'companyName' })
    @!field.label({ text: 'Nom de la compagnie' })
    @!input.control({ placeholder: 'Votre compagnie de transport' })
    @!field.error()
    @end
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      @field.root({ name: 'firstName' })
      @!field.label({ text: 'Prénom' })
      @!input.control({ placeholder: 'Jean' })
      @!field.error()
      @end
    </div>
    <div>
      @field.root({ name: 'lastName' })
      @!field.label({ text: 'Nom' })
      @!input.control({ placeholder: 'Dupont' })
      @!field.error()
      @end
    </div>
  </div>

  <div>
    @field.root({ name: 'email' })
    @!field.label({ text: 'Email' })
    @!input.control({ type: 'email', autocomplete: 'email', placeholder: 'vous@example.com' })
    @!field.error()
    @end
  </div>

  <div>
    @field.root({ name: 'password' })
    @!field.label({ text: 'Mot de passe' })
    @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
    @!field.error()
    @end
  </div>

  <div>
    @field.root({ name: 'passwordConfirmation' })
    @!field.label({ text: 'Confirmer le mot de passe' })
    @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
    @!field.error()
    @end
  </div>

  <div class="pt-1">
    @!button({ text: "S'inscrire", type: 'submit', class: 'w-full' })
  </div>
</div>
@end

<p class="mt-6 text-center text-sm text-on-surface">
  Déjà inscrit ?
  <a href="{{ route('session.create') }}" class="font-medium text-on-surface-strong hover:underline">Se
    connecter</a>
</p>
@end