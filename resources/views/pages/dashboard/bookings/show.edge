@layout.dashboard()
  <div class="mx-auto max-w-4xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">
        Réservation #{{ booking.id.substring(0, 8).toUpperCase() }}
      </h1>
      <a href="{{ route('dashboard.bookings.index') }}"
        class="inline-flex items-center gap-2 rounded-radius border border-outline px-4 py-2.5 text-sm font-medium text-on-surface hover:bg-surface-alt transition-colors">
        @svg('tabler:arrow-left', { class: 'size-4' })
        <span>Retour</span>
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      {{-- Trip details card --}}
      <div class="rounded-radius border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:map-2', { class: 'size-4' })
          Voyage
        </h2>
        <div class="space-y-2 text-sm">
          <div class="font-medium text-on-surface-strong">
            {{ booking.trip.route.departureCity.name }} → {{ booking.trip.route.arrivalCity.name }}
          </div>
          <div class="text-on-surface">
            Départ : {{ booking.trip.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
          </div>
          <div class="text-on-surface">
            Bus : {{ booking.trip.bus.licensePlate }}
          </div>
          <div class="mt-2">
            @if(booking.trip.status === 'scheduled')
              <span class="inline-flex items-center rounded-full bg-blue-100 px-2.5 py-0.5 text-xs font-medium text-blue-800">Planifié</span>
            @elseif(booking.trip.status === 'in_progress')
              <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">En cours</span>
            @elseif(booking.trip.status === 'completed')
              <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Terminé</span>
            @else
              <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Annulé</span>
            @end
          </div>
        </div>
      </div>

      {{-- Customer info card --}}
      <div class="rounded-radius border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:user', { class: 'size-4' })
          Client
        </h2>
        <div class="space-y-2 text-sm">
          <div class="font-medium text-on-surface-strong">
            {{ booking.customer.firstName }} {{ booking.customer.lastName }}
          </div>
          <div class="text-on-surface">{{ booking.customer.phone }}</div>
          @if(booking.customer.email)
            <div class="text-on-surface">{{ booking.customer.email }}</div>
          @end
        </div>
      </div>

      {{-- Payment status card --}}
      <div class="rounded-radius border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:credit-card', { class: 'size-4' })
          Paiement
        </h2>
        <div class="space-y-2 text-sm">
          <div class="text-2xl font-bold text-on-surface-strong">{{ booking.totalAmount }} FCFA</div>
          @if(booking.payment)
            <div class="text-on-surface">
              Méthode : {{ booking.payment.paymentMethod === 'cash' ? 'Espèces' : booking.payment.paymentMethod }}
            </div>
            <div class="mt-2">
              @if(booking.payment.status === 'success')
                <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Payé</span>
              @elseif(booking.payment.status === 'pending')
                <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">En attente</span>
              @else
                <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Échoué</span>
              @end
            </div>
          @else
            <span class="inline-flex items-center rounded-full bg-neutral-100 px-2.5 py-0.5 text-xs font-medium text-neutral-800">Aucun paiement</span>
          @end
        </div>
      </div>
    </div>

    {{-- Booking status + actions --}}
    <div class="mt-6 flex items-center gap-4 rounded-radius border border-outline bg-surface p-5">
      <div class="flex-1">
        <span class="text-sm font-medium text-on-surface">Statut de la réservation :</span>
        <span class="ml-2">
          @if(booking.status === 'pending')
            <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">En attente</span>
          @elseif(booking.status === 'confirmed')
            <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Confirmée</span>
          @else
            <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-medium text-red-800">Annulée</span>
          @end
        </span>
      </div>
      @can('permission', 'booking:update')
        @if(booking.status === 'confirmed' && booking.trip.departureTime > new Date())
          <a href="{{ route('dashboard.bookings.edit', { id: booking.id }) }}"
            class="inline-flex items-center gap-2 rounded-radius border border-outline px-4 py-2 text-sm font-medium text-on-surface hover:bg-surface-alt transition-colors">
            @svg('tabler:edit', { class: 'size-4' })
            <span>Modifier</span>
          </a>
          @form({ route: 'dashboard.bookings.destroy', routeParams: { id: booking.id }, method: 'DELETE' })
            <button type="submit"
              class="inline-flex cursor-pointer items-center gap-2 rounded-radius bg-danger px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity"
              onclick="return confirm('Annuler cette réservation ? Cette action est irréversible.')">
              @svg('tabler:ban', { class: 'size-4' })
              <span>Annuler la réservation</span>
            </button>
          @end
        @end
      @end
    </div>

    {{-- Passengers table --}}
    <div class="mt-6">
      <h2 class="mb-4 text-base font-semibold text-on-surface-strong">Passagers</h2>
      <div class="overflow-hidden rounded-radius border border-outline bg-surface">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-outline bg-surface-alt text-xs uppercase tracking-wider text-on-surface">
            <tr>
              <th class="px-6 py-3">Nom</th>
              <th class="px-6 py-3">Siège</th>
              <th class="px-6 py-3">Code</th>
              <th class="px-6 py-3">Statut</th>
              <th class="px-6 py-3 text-right">Ticket</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-outline">
            @each(passenger in booking.passengers)
              <tr class="hover:bg-surface-alt/50">
                <td class="px-6 py-4 font-medium text-on-surface-strong">
                  {{ passenger.firstName }} {{ passenger.lastName }}
                </td>
                <td class="px-6 py-4 text-on-surface">{{ passenger.seatNumber }}</td>
                <td class="px-6 py-4 font-mono text-xs text-on-surface">{{ passenger.code }}</td>
                <td class="px-6 py-4">
                  @if(passenger.status === 'boarded')
                    <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-medium text-green-800">Embarqué</span>
                  @else
                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-medium text-yellow-800">En attente</span>
                  @end
                </td>
                <td class="px-6 py-4 text-right">
                  <a href="{{ route('dashboard.tickets.download', { id: booking.id, passengerId: passenger.id }) }}"
                    class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-secondary transition-colors"
                    target="_blank">
                    @svg('tabler:download', { class: 'size-4' })
                    <span>Ticket</span>
                  </a>
                </td>
              </tr>
            @end
          </tbody>
        </table>

        @if(!booking.passengers.length)
          <div class="px-6 py-12 text-center text-on-surface">
            Aucun passager enregistré.
          </div>
        @end
      </div>
    </div>
  </div>
@end
