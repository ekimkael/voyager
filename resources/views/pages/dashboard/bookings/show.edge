@layout.dashboard()
  <div class="mx-auto max-w-4xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">
        Réservation #{{ booking.id.substring(0, 8).toUpperCase() }}
      </h1>
      <a href="{{ route('dashboard.bookings.index') }}"
        class="inline-flex items-center gap-2 rounded-md border border-outline bg-surface px-4 py-2 text-sm font-medium text-on-surface shadow-xs hover:bg-surface-alt hover:text-on-surface-strong">
        @svg('tabler:arrow-left', { class: 'size-4' })
        Retour
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

      {{-- Trip details card --}}
      <div class="rounded-lg border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:map-2', { class: 'size-4' })
          Voyage
        </h2>
        <div class="space-y-2 text-sm">
          <div class="font-medium text-on-surface-strong">
            {{ booking.trip.route.departureCity.name }} → {{ booking.trip.route.arrivalCity.name }}
          </div>
          <div class="text-on-surface">
            Départ : {{ booking.trip.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
          </div>
          <div class="text-on-surface">
            Bus : {{ booking.trip.bus.licensePlate }}
          </div>
          <div class="mt-2">
            @if(booking.trip.status === 'scheduled')
              @!badge({ variant: 'info', text: 'Planifié' })
            @elseif(booking.trip.status === 'in_progress')
              @!badge({ variant: 'warning', text: 'En cours' })
            @elseif(booking.trip.status === 'completed')
              @!badge({ variant: 'success', text: 'Terminé' })
            @else
              @!badge({ variant: 'danger', text: 'Annulé' })
            @end
          </div>
        </div>
      </div>

      {{-- Customer info card --}}
      <div class="rounded-lg border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:user', { class: 'size-4' })
          Client
        </h2>
        @if(booking.customer)
        <div class="space-y-2 text-sm">
          <div class="font-medium text-on-surface-strong">
            {{ booking.customer.firstName }} {{ booking.customer.lastName }}
          </div>
          <div class="text-on-surface">{{ booking.customer.phone }}</div>
          @if(booking.customer.email)
            <div class="text-on-surface">{{ booking.customer.email }}</div>
          @end
        </div>
        @else
        <p class="text-sm text-on-surface">Aucun client associé</p>
        @end
      </div>

      {{-- Payment status card --}}
      <div class="rounded-lg border border-outline bg-surface p-5">
        <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-on-surface">
          @svg('tabler:credit-card', { class: 'size-4' })
          Paiement
        </h2>
        <div class="space-y-2 text-sm">
          <div class="text-2xl font-bold text-on-surface-strong">{{ Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'XAF' }).format(booking.totalAmount) }}</div>
          @if(booking.payment)
            <div class="text-on-surface">
              Méthode : {{ booking.payment.paymentMethod === 'cash' ? 'Espèces' : booking.payment.paymentMethod }}
            </div>
            <div class="mt-2">
              @if(booking.payment.status === 'success')
                @!badge({ variant: 'success', text: 'Payé' })
              @elseif(booking.payment.status === 'pending')
                @!badge({ variant: 'warning', text: 'En attente' })
              @else
                @!badge({ variant: 'danger', text: 'Échoué' })
              @end
            </div>
          @else
            @!badge({ variant: 'neutral', text: 'Aucun paiement' })
          @end
        </div>
      </div>
    </div>

    {{-- Booking status + actions --}}
    <div class="mt-6 flex items-center gap-4 rounded-lg border border-outline bg-surface p-5">
      <div class="flex-1">
        <span class="text-sm font-medium text-on-surface">Statut de la réservation :</span>
        <span class="ml-2">
          @if(booking.status === 'pending')
            @!badge({ variant: 'warning', text: 'En attente' })
          @elseif(booking.status === 'confirmed')
            @!badge({ variant: 'success', text: 'Confirmée' })
          @else
            @!badge({ variant: 'danger', text: 'Annulée' })
          @end
        </span>
      </div>
      @can('permission', 'booking:update')
        @if(booking.status === 'confirmed' && booking.trip.departureTime > new Date())
          <a href="{{ route('dashboard.bookings.edit', { id: booking.id }) }}"
            class="inline-flex items-center gap-2 rounded-md border border-outline px-4 py-2 text-sm font-medium text-on-surface hover:bg-surface-alt transition-colors">
            @svg('tabler:edit', { class: 'size-4' })
            Modifier
          </a>
          @form({ route: 'dashboard.bookings.destroy', routeParams: { id: booking.id }, method: 'DELETE' })
            <button type="submit"
              class="inline-flex cursor-pointer items-center gap-2 rounded-md bg-danger px-4 py-2 text-sm font-medium text-white hover:opacity-90 transition-opacity"
              onclick="return confirm('Annuler cette réservation ? Cette action est irréversible.')">
              @svg('tabler:ban', { class: 'size-4' })
              Annuler la réservation
            </button>
          @end
        @end
      @end
    </div>

    {{-- Passengers table --}}
    <div class="mt-6">
      <h2 class="mb-4 text-base font-semibold text-on-surface-strong">Passagers</h2>

      @table.root()
        @table.header()
          @table.cell({ head: true })
            Nom
          @end
          @table.cell({ head: true })
            Siège
          @end
          @table.cell({ head: true })
            Code
          @end
          @table.cell({ head: true })
            Statut
          @end
          @table.cell({ head: true })
          @end
        @end

        <tbody>
          @each(passenger in booking.passengers)
            @table.row()
              @table.cell()
                <span class="font-medium">{{ passenger.firstName }} {{ passenger.lastName }}</span>
              @end
              @table.cell()
                {{ passenger.seatNumber }}
              @end
              @table.cell()
                <span class="font-mono text-xs">{{ passenger.code }}</span>
              @end
              @table.cell()
                @if(passenger.status === 'boarded')
                  @!badge({ variant: 'success', text: 'Embarqué' })
                @else
                  @!badge({ variant: 'warning', text: 'En attente' })
                @end
              @end
              <td class="px-4 py-3 text-right">
                <a href="{{ route('dashboard.tickets.download', { id: booking.id, passengerId: passenger.id }) }}"
                  class="inline-flex items-center gap-1.5 text-sm text-primary hover:text-secondary transition-colors"
                  target="_blank">
                  @svg('tabler:download', { class: 'size-4' })
                  Ticket
                </a>
              </td>
            @end
          @end

          @if(!booking.passengers.length)
            @!table.empty({ colspan: 5, message: 'Aucun passager enregistré.' })
          @end
        </tbody>
      @end
    </div>
  </div>
@end
