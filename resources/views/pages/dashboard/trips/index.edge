@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Voyages</h1>
      <div class="flex items-center gap-3">
        <a href="{{ route('trips.history') }}"
          class="inline-flex items-center gap-2 rounded-md border border-outline bg-surface px-4 py-2 text-sm font-medium text-on-surface shadow-xs hover:bg-surface-alt hover:text-on-surface-strong">
          @svg('tabler:history', { class: 'size-4' })
          Historique
        </a>
        @can('permission', 'trip:create')
          <a href="{{ route('trips.create') }}"
            class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
            @svg('tabler:plus', { class: 'size-4' })
            Nouveau voyage
          </a>
        @end
      </div>
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Route
        @end
        @table.cell({ head: true })
          Bus
        @end
        @table.cell({ head: true })
          Chauffeur
        @end
        @table.cell({ head: true })
          Départ
        @end
        @table.cell({ head: true })
          Classe
        @end
        @table.cell({ head: true })
          Tarif
        @end
        @table.cell({ head: true })
          Statut
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(item in trips)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ item.route.departureCity.name }} → {{ item.route.arrivalCity.name }}</span>
            @end
            @table.cell()
              {{ item.bus.licensePlate }}
            @end
            @table.cell()
              {{ item.driver.fullName }}
            @end
            @table.cell()
              {{ item.departureTime.toFormat('dd/MM/yyyy HH:mm') }}
            @end
            @table.cell()
              @if(item.travelClass === 'vip')
                @!badge({ variant: 'info', text: 'VIP' })
              @else
                @!badge({ variant: 'neutral', text: 'Standard' })
              @end
            @end
            @table.cell()
              {{ item.price }} FCFA
            @end
            @table.cell()
              @if(item.status === 'scheduled')
                @!badge({ variant: 'info', text: 'Planifié' })
              @else
                @!badge({ variant: 'warning', text: 'En cours' })
              @end
            @end
            @table.cell()
              @dropdown_menu.root()
                @!dropdown_menu.trigger()
                @dropdown_menu.content()
                  @can('permission', 'trip:update')
                    @if(item.status === 'scheduled')
                      @dropdown_menu.item({ href: route('trips.transition', { id: item.id }), method: 'PUT', hiddenInputs: { status: 'in_progress' }, onclick: "return confirm('Démarrer ce voyage ?')" })
                        @svg('tabler:player-play', { class: 'size-4' })
                        Démarrer
                      @end
                    @end

                    @if(item.status === 'in_progress')
                      @dropdown_menu.item({ href: route('trips.transition', { id: item.id }), method: 'PUT', hiddenInputs: { status: 'completed' }, onclick: "return confirm('Marquer ce voyage comme terminé ?')" })
                        @svg('tabler:circle-check', { class: 'size-4' })
                        Compléter
                      @end
                    @end

                    @if(item.status === 'scheduled' || item.status === 'in_progress')
                      @dropdown_menu.item({ href: route('trips.edit', { id: item.id }) })
                        @svg('tabler:pencil', { class: 'size-4' })
                        Modifier
                      @end
                    @end
                  @end

                  @if(item.status === 'scheduled' || item.status === 'in_progress')
                    @!dropdown_menu.separator()
                  @end

                  @can('permission', 'trip:update')
                    @if(item.status === 'scheduled' || item.status === 'in_progress')
                      @dropdown_menu.item({ href: route('trips.transition', { id: item.id }), method: 'PUT', variant: 'destructive', hiddenInputs: { status: 'cancelled' }, onclick: "return confirm('Annuler ce voyage ?')" })
                        @svg('tabler:x', { class: 'size-4' })
                        Annuler
                      @end
                    @end
                  @end

                  @can('permission', 'trip:delete')
                    @if(item.status === 'scheduled')
                      @dropdown_menu.item({ href: route('trips.destroy', { id: item.id }), method: 'DELETE', variant: 'destructive', onclick: "return confirm('Supprimer ce voyage ?')" })
                        @svg('tabler:trash', { class: 'size-4' })
                        Supprimer
                      @end
                    @end
                  @end
                @end
              @end
            @end
          @end
        @end

        @if(!trips.length)
          @!table.empty({ colspan: 8, message: 'Aucun voyage actif' })
        @end
      </tbody>
    @end
  </div>
@end
