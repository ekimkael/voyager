@layout.dashboard()
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-on-surface-strong">Rôles</h1>
      @can('permission', 'role:create')
        <a href="{{ route('roles.create') }}"
          class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-on-primary shadow-xs hover:bg-primary/90">
          @svg('tabler:plus', { class: 'size-4' })
          Nouveau rôle
        </a>
      @end
    </div>

    @table.root()
      @table.header()
        @table.cell({ head: true })
          Nom
        @end
        @table.cell({ head: true })
          Type
        @end
        @table.cell({ head: true })
          Parent
        @end
        @table.cell({ head: true })
          Permissions
        @end
        @table.cell({ head: true })
          Utilisateurs
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(role in rootRoles)
          @table.row()
            @table.cell()
              <span class="font-medium">{{ role.name }}</span>
            @end
            @table.cell()
              @if(role.isSystem)
                @!badge({ variant: 'info', text: 'Système' })
              @else
                @!badge({ variant: 'neutral', text: 'Custom' })
              @end
            @end
            @table.cell()
              —
            @end
            @table.cell()
              {{ role.$extras.permissionsCount }}
            @end
            @table.cell()
              {{ role.$extras.usersCount }}
            @end
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                @can('permission', 'role:read')
                  <a href="{{ route('roles.show', { id: role.id }) }}"
                    class="text-on-surface hover:text-primary transition-colors" title="Voir">
                    @svg('tabler:eye', { class: 'size-4' })
                  </a>
                @end
                @if(!role.isSystem)
                  @can('permission', 'role:update')
                    <a href="{{ route('roles.edit', { id: role.id }) }}"
                      class="text-on-surface hover:text-primary transition-colors" title="Modifier">
                      @svg('tabler:edit', { class: 'size-4' })
                    </a>
                  @end
                  @can('permission', 'role:delete')
                    @form({ route: 'roles.destroy', routeParams: { id: role.id }, method: 'DELETE' })
                      <button type="submit"
                        class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                        onclick="return confirm('Supprimer ce rôle ?')" title="Supprimer">
                        @svg('tabler:trash', { class: 'size-4' })
                      </button>
                    @end
                  @end
                @end
              </div>
            </td>
          @end

          @if(childMap.has(role.id))
            @each(child in childMap.get(role.id))
              <tr class="border-b border-outline last:border-0 hover:bg-surface-alt/50 transition-colors bg-surface-alt/20">
                <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
                  <span class="ml-6 inline-flex items-center gap-1">
                    @svg('tabler:corner-down-right', { class: 'size-4 text-on-surface' })
                    <span class="font-medium">{{ child.name }}</span>
                  </span>
                </td>
                <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
                  @if(child.isSystem)
                    @!badge({ variant: 'info', text: 'Système' })
                  @else
                    @!badge({ variant: 'neutral', text: 'Custom' })
                  @end
                </td>
                <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">{{ role.name }}</td>
                <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">{{ child.$extras.permissionsCount }}</td>
                <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">{{ child.$extras.usersCount }}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-2">
                    @can('permission', 'role:read')
                      <a href="{{ route('roles.show', { id: child.id }) }}"
                        class="text-on-surface hover:text-primary transition-colors" title="Voir">
                        @svg('tabler:eye', { class: 'size-4' })
                      </a>
                    @end
                    @if(!child.isSystem)
                      @can('permission', 'role:update')
                        <a href="{{ route('roles.edit', { id: child.id }) }}"
                          class="text-on-surface hover:text-primary transition-colors" title="Modifier">
                          @svg('tabler:edit', { class: 'size-4' })
                        </a>
                      @end
                      @can('permission', 'role:delete')
                        @form({ route: 'roles.destroy', routeParams: { id: child.id }, method: 'DELETE' })
                          <button type="submit"
                            class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                            onclick="return confirm('Supprimer ce rôle ?')" title="Supprimer">
                            @svg('tabler:trash', { class: 'size-4' })
                          </button>
                        @end
                      @end
                    @end
                  </div>
                </td>
              </tr>
            @end
          @end
        @end

        @if(!rootRoles.length)
          @!table.empty({ colspan: 6, message: 'Aucun rôle trouvé.' })
        @end
      </tbody>
    @end
  </div>
@end
