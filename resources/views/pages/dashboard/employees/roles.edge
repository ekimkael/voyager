@layout.dashboard()
  <div class="mx-auto max-w-4xl">

    {{-- Header --}}
    <div class="mb-6">
      <div class="flex items-center gap-2 text-sm text-on-surface mb-2">
        <a href="{{ route('employees.index') }}" class="hover:text-primary transition-colors">Employés</a>
        @svg('tabler:chevron-right', { class: 'size-4' })
        <span>{{ employee.fullName }}</span>
        @svg('tabler:chevron-right', { class: 'size-4' })
        <span>Rôles</span>
      </div>
      <h1 class="text-2xl font-bold text-on-surface-strong">Rôles de {{ employee.fullName }}</h1>
    </div>

    {{-- Assign Role Form --}}
    @if(availableRoles.length)
      <div class="mb-6 rounded-lg border border-outline bg-surface p-6">
        <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-on-surface">Assigner un rôle</h2>
        @form({ route: 'employees.assignRole', routeParams: { id: employee.id }, method: 'POST' })
          <div class="flex items-end gap-4">
            <div class="flex-1">
              @field.root({ name: 'roleId' })
                @!field.label({ text: 'Rôle' })
                @!select.control({
                  options: availableRoles.map((r) => ({
                    value: r.id,
                    name: r.name,
                  }))
                })
                @!field.error()
              @end
            </div>
            <div class="flex-1">
              @field.root({ name: 'expiresAt' })
                @!field.label({ text: 'Date d\'expiration (optionnel)' })
                @!input.control({ type: 'date' })
                @!field.error()
              @end
            </div>
            <div>
              @!button({ text: 'Assigner', type: 'submit' })
            </div>
          </div>
        @end
      </div>
    @end

    {{-- Current Roles --}}
    @table.root()
      @table.header()
        @table.cell({ head: true })
          Rôle
        @end
        @table.cell({ head: true })
          Assigné le
        @end
        @table.cell({ head: true })
          Expire le
        @end
        @table.cell({ head: true })
          Accordé par
        @end
        @table.cell({ head: true })
        @end
      @end

      <tbody>
        @each(assignment in assignments)
          <tr class="border-b border-outline last:border-0 hover:bg-surface-alt/50 transition-colors {{ assignment.expiresAt && assignment.expiresAt < new Date() ? 'opacity-50' : '' }}">
            <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
              <a href="{{ route('roles.show', { id: assignment.role.id }) }}" class="font-medium hover:text-primary transition-colors">
                {{ assignment.role.name }}
              </a>
              @if(assignment.role.isSystem)
                @!badge({ variant: 'info', text: 'Système' })
              @end
              @if(assignment.isTemporary)
                @!badge({ variant: 'warning', text: 'Temporaire' })
              @end
            </td>
            <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
              {{ assignment.createdAt.toFormat('dd MMM yyyy', { locale: 'fr' }) }}
            </td>
            <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
              @if(assignment.expiresAt)
                @if(assignment.expiresAt < new Date())
                  @!badge({ variant: 'danger', text: 'Expiré ' + assignment.expiresAt.toFormat('dd MMM yyyy', { locale: 'fr' }) })
                @else
                  {{ assignment.expiresAt.toFormat('dd MMM yyyy', { locale: 'fr' }) }}
                @end
              @else
                Permanent
              @end
            </td>
            <td class="px-4 py-3 text-on-surface-strong whitespace-nowrap">
              {{ assignment.granter?.fullName || '—' }}
            </td>
            <td class="px-4 py-3">
              @form({ route: 'employees.revokeRole', routeParams: { id: employee.id, assignmentId: assignment.id }, method: 'DELETE' })
                <button type="submit"
                  class="cursor-pointer text-on-surface hover:text-danger transition-colors"
                  onclick="return confirm('Retirer ce rôle ?')">
                  @svg('tabler:trash', { class: 'size-4' })
                </button>
              @end
            </td>
          </tr>
        @end

        @if(!assignments.length)
          @!table.empty({ colspan: 5, message: 'Aucun rôle assigné à cet employé.' })
        @end
      </tbody>
    @end
  </div>
@end
