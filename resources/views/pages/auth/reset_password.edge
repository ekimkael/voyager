@layout.base()
<div class="flex min-h-screen">
  {{-- Left panel - decorative --}}
  <div class="auth-panel-bg relative hidden flex-col justify-between overflow-hidden p-10 lg:flex lg:w-1/2 xl:w-[50%]">
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]"
      style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;)">
    </div>

    <a href="/" class="relative z-10 text-xl font-bold tracking-tight text-white">Voyager</a>

    <div class="relative z-10">
      <div class="animate-float">
        <div
          class="mb-8 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-sm text-white/80 backdrop-blur-sm">
          <span class="inline-block size-2 rounded-full bg-sky-400"></span>
          Nouveau mot de passe
        </div>
      </div>
      <h2 class="text-3xl font-semibold leading-tight text-white xl:text-4xl">
        Choisissez un nouveau mot de passe sécurisé.
      </h2>
      <p class="mt-4 max-w-md text-base leading-relaxed text-white/60">
        Utilisez au moins 8 caractères pour protéger votre compte.
      </p>
    </div>

    <p class="relative z-10 text-sm text-white/40">&copy; {{ new Date().getFullYear() }} Voyager</p>
  </div>

  {{-- Right panel --}}
  <div class="flex flex-1 flex-col">

    @include('partials/flash_alerts')

    <div class="flex flex-1 items-center justify-center px-6 pb-12 sm:px-10">
      <div class="w-full max-w-md animate-fade-rise">

        @if(status === 'error')
        {{-- Error state --}}
        <div class="text-center">
          <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-danger/10">
            @svg('tabler:lock-x', { class: 'size-6 text-danger' })
          </div>
          <h1 class="text-2xl font-semibold text-on-surface-strong">Lien invalide</h1>
          <p class="mt-2 text-base text-on-surface">{{ message }}</p>
          <div class="mt-6">
            <a href="{{ route('password.forgot') }}" class="font-medium text-on-surface-strong hover:underline">
              Demander un nouveau lien
            </a>
          </div>
        </div>
        @else
        {{-- Reset form --}}
        <div class="mb-8">
          <h1 class="text-3xl font-semibold tracking-tight text-on-surface-strong">Nouveau mot de passe</h1>
          <p class="mt-2 text-base text-on-surface">Choisissez un mot de passe sécurisé pour votre compte</p>
        </div>

        @form({ route: 'password.update', method: 'POST' })
        <input type="hidden" name="token" value="{{ token }}" />
        <div class="flex flex-col gap-5">
          <div>
            @field.root({ name: 'password' })
            @!field.label({ text: 'Nouveau mot de passe' })
            @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••', autofocus: true
            })
            @!field.error()
            @end
          </div>

          <div>
            @field.root({ name: 'passwordConfirmation' })
            @!field.label({ text: 'Confirmer le mot de passe' })
            @!input.control({ type: 'password', autocomplete: 'new-password', placeholder: '••••••••' })
            @!field.error()
            @end
          </div>

          <div class="pt-1">
            @!button({ text: 'Réinitialiser', type: 'submit' })
          </div>
        </div>
        @end
        @end

      </div>
    </div>
  </div>
</div>
@end