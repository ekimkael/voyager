@let(buttonTextFromSlot = await $slots.main())
@let(buttonText = buttonTextFromSlot.trim() ? buttonTextFromSlot : $props.get('text') ?? '')
@let(variant = $props.get('variant') || 'default')
@let(size = $props.get('size') || 'default')

@let(variantClasses = {
'default': 'bg-primary text-on-primary shadow-xs hover:bg-primary/90',
'destructive': 'bg-danger text-on-danger shadow-xs hover:bg-danger/90 focus-visible:ring-danger/20',
'outline': 'border border-outline bg-surface shadow-xs hover:bg-surface-alt hover:text-on-surface-strong',
'secondary': 'bg-secondary text-on-secondary shadow-xs hover:bg-secondary/80',
'ghost': 'hover:bg-surface-alt hover:text-on-surface-strong',
'link': 'text-primary underline-offset-4 hover:underline',
})

@let(sizeClasses = {
'default': 'h-9 px-4 py-2 has-[>svg]:px-3',
'xs': 'h-6 gap-1 rounded-md px-2 text-xs has-[>svg]:px-1.5 [&_svg:not([class*=size-])]:size-3',
'sm': 'h-8 gap-1.5 rounded-md px-3 has-[>svg]:px-2.5',
'lg': 'h-10 rounded-md px-6 has-[>svg]:px-4',
'icon': 'size-9',
'icon-xs': 'size-6 rounded-md [&_svg:not([class*=size-])]:size-3',
'icon-sm': 'size-8',
'icon-lg': 'size-10',
})

@let(baseClasses = [
'inline-flex', 'shrink-0', 'items-center', 'justify-center', 'gap-2', 'rounded-md',
'text-sm', 'font-medium', 'whitespace-nowrap', 'cursor-pointer',
'transition-all', 'outline-none',
'focus-visible:border-primary', 'focus-visible:ring-[3px]', 'focus-visible:ring-primary/50',
'disabled:pointer-events-none', 'disabled:opacity-50',
'aria-[invalid=true]:border-danger', 'aria-[invalid=true]:ring-danger/20',
'[&_svg]:pointer-events-none', '[&_svg]:shrink-0', '[&_svg:not([class*=size-])]:size-4',
variantClasses[variant] || variantClasses['default'],
sizeClasses[size] || sizeClasses['default'],
])

<button {{
  $props.except(['text', 'variant', 'size']).merge({
    class: baseClasses,
    'data-slot': 'button',
    'data-variant': variant,
    'data-size': size,
  }).toAttrs()
}}>{{{ buttonText }}}</button>
